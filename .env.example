# Names only — never put real values in this file or commit a filled-in .env.
# Real values live in Modal secrets (see README). Create them with:
#   scripts/create_phase1_secrets.sh   (vllm + proxy)
#   scripts/create_gateway_secret.sh   (gateway; generates SESSION_SIGNING_KEY)

# Modal secret: model-in-modal-vllm
VLLM_API_KEY=

# Modal secret: model-in-modal-proxy  (from a Modal proxy auth token)
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

# Modal secret: model-in-modal-gateway
# TURNSTILE_SECRET may stay empty until Phase 5: the script then uses Cloudflare's test secret.
SESSION_SIGNING_KEY=
TURNSTILE_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Modal secret: huggingface  (NOT needed: Qwen/Qwen3.5-9B is not gated)
# HF_TOKEN=
